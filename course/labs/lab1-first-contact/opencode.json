{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/gpt-5.4-mini",
  "small_model": "opencode/gpt-5.4-nano",
  "mcp": {
    "time": {
      "type": "local",
      "command": ["uvx", "mcp-server-time"],
      "enabled": true,
      "timeout": 60000
    },
    "time-js": {
      "type": "local",
      "command": ["node", "time-server.mjs"],
      "enabled": false
    },
    "everything": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-everything@2.0.0"],
      "enabled": true,
      "timeout": 60000
    },
    "time-tap": {
      "type": "local",
      "command": ["node", "mcp-tap.mjs", "mcp-traffic.log", "--", "uvx", "mcp-server-time"],
      "enabled": false,
      "timeout": 60000
    }
  }
}
